{
    "name": "bundlessdev",
    "version": "1.0.10",
    "description": "Build on Browser, Bundle less",
    "main": "dist/bundless.acorn.min.js",
    "module": "dist/bundless.acorn.min.js",
    "exports": {
        ".": "./dist/bundless.acorn.min.js",
        "./acorn": "./dist/bundless.acorn.min.js",
        "./acorn/dev": "./dist/bundless.acorn.dev.js",
        "./babel": "./dist/bundless.babel.min.js",
        "./meriyah": "./dist/bundless.meriyah.min.js",
        "./sucrase": "./dist/bundless.sucrase.min.js",
        "./webpack": "./dist/bundless.webpack.cjs",
        "./webpack/loader": "./dist/bundless.webpack-loader.cjs",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.MD"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/karpatic/bundless.git"
    },
    "homepage": "https://bundless.dev/",
    "bugs": {
        "url": "https://github.com/karpatic/bundless/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test": "node --test test/*.test.mjs",
        "rollup": "rollup --config rollup.config.js",
        "buildb": "esbuild ./src/bundless.babel.js --bundle --minify --outfile=./dist/bundless.babel.min.js --format=esm",
        "buildw": "esbuild ./src/webpack/index.cjs --bundle --platform=node --format=cjs --outfile=./dist/bundless.webpack.cjs && esbuild ./src/webpack/loader.cjs --bundle --platform=node --format=cjs --outfile=./dist/bundless.webpack-loader.cjs",
        "compress:dist": "node scripts/brotli-dist.mjs",
        "release:build": "npm run rollup && npm run buildb && npm run buildw && npm run compress:dist",
        "compress": "npm run compress:dist",
        "compressa": "npx terser ./dist/bundless.acorn.min.js --compress --output ./dist/bundless.acorn.min.js && brotli-cli compress ./dist/bundless.acorn.min.js",
        "rollm": "npx terser ./dist/bundless.meriyah.min.js --compress --output ./dist/bundless.meriyah.min.js && brotli-cli compress ./dist/bundless.meriyah.min.js",
        "rolls": "&& npx terser ./dist/bundless.sucrase.min.js --compress --output ./dist/bundless.sucrase.min.js && brotli-cli compress ./dist/bundless.sucrase.min.js",
        "minifyjsx": "npx terser ./rsc/acorn/acorn-jsx.js --compress --output ./rsc/acorn/acorn-jsx.min.mjs",
        "minifyacorn": "esbuild ./rsc/acorn/acorn.mjs --bundle --minify --outfile=./rsc/acorn/acorn.min.mjs --format=esm",
        "build-react": "webpack --config ./benchmarks/webpack.config.js && brotli-cli compress ./benchmarks/react.js",
        "dev": "webpack serve --mode development --open"
    },
    "devDependencies": {
        "@babel/core": "^7.15.5",
        "@babel/preset-env": "^7.15.6",
        "@babel/preset-react": "^7.15.7",
        "@rollup/plugin-replace": "^6.0.2",
        "babel-loader": "^8.2.3",
        "esbuild": "^0.25.11",
        "rollup": "^2.79.2",
        "rollup-plugin-gzip": "^4.0.1",
        "rollup-plugin-terser": "^7.0.2",
        "terser-webpack-plugin": "^5.3.14",
        "webpack": "^5.98.0",
        "webpack-cli": "^4.10.0",
        "webpack-dev-server": "^4.15.2"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    }
}
